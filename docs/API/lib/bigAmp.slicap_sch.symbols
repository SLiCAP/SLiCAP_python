<svg xmlns="http://www.w3.org/2000/svg">
  <defs>
<g xmlns="http://www.w3.org/2000/svg" id="port" data-prefix="P" data-nodes="port" data-params="name||0|1" data-description="Hierarchical connection">

       <!-- pentagon: pointed top at pin, rectangular body below -->
       <polyline points="0 0  5 5  5 20  -5 20  -5 5  0 0" fill="white" stroke="black" stroke-width="1" />
       
       <!-- Pins -->
       <circle cx="0" cy="0" r="0.5" class="node" data-node="port" />
    </g>

<g xmlns="http://www.w3.org/2000/svg" id="R" data-prefix="R" data-nodes="pos neg" data-model="R|0" data-params="value|?|0|1; dcvar||0|0; dcvarlot||0|0; noisetemp||0|0; noiseflow||0|0" data-description="Resistor (nonzero resistance)" data-info="https://www.slicap.org/syntax/devices.html#r-resistor">

       <rect x="-5" y="-10" width="10" height="20" fill="none" stroke="black" stroke-width="1" />
       <line x1="0" y1="-20" x2="0" y2="-10" stroke="black" stroke-width="1" />
       <line x1="0" y1="10" x2="0" y2="20" stroke="black" stroke-width="1" />

       <!-- Pins -->
       <circle cx="0" cy="-20" r="0.5" class="node" data-node="pos" />
       <circle cx="0" cy="20" r="0.5" class="node" data-node="neg" />
    </g>
    
    
<g xmlns="http://www.w3.org/2000/svg" id="smallAmp" data-prefix="X" data-nodes="inN inP outN outP" data-model="smallAmp|1" data-params="A_v|{A}|1|1;r_o|{R}|1|1" data-show-pinnames="true" data-description="Subcircuit smallAmp">
      <rect x="-25" y="-20" width="50" height="40" fill="none" stroke="black" stroke-width="1" />
      
      <!-- Pins -->
      <line x1="-25" y1="10" x2="-35" y2="10" stroke="black" stroke-width="1" />
      <line x1="-25" y1="-10" x2="-35" y2="-10" stroke="black" stroke-width="1" />
      <line x1="25" y1="10" x2="35" y2="10" stroke="black" stroke-width="1" />
      <line x1="25" y1="-10" x2="35" y2="-10" stroke="black" stroke-width="1" />
      
      <circle cx="-35" cy="10" r="0.5" class="node" data-node="inN" />
      <circle cx="-35" cy="-10" r="0.5" class="node" data-node="inP" />
      <circle cx="35" cy="10" r="0.5" class="node" data-node="outN" />
      <circle cx="35" cy="-10" r="0.5" class="node" data-node="outP" />
  </g>

<g xmlns="http://www.w3.org/2000/svg" id="0" data-prefix="GND" data-nodes="0" data-params="name|0|0|0" data-description="Reference node (GND=0) connection">

       <!-- connection node: (0, 0) -->
       <line x1="0" y1="0" x2="0" y2="5" stroke="black" stroke-width="1" />
       <polyline points="0 5 3 5 0 10 -3 5 0 5" stroke="black" stroke-width="1" fill="none" />
      
       <!-- Pins -->
       <circle cx="0" cy="0" r="0.5" class="node" data-node="0" />
    </g>

    
  </defs>
</svg>
