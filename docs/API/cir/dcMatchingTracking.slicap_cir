dcMatchingTracking

.param
+ V_DC={V_DC*(1 + T_Delta*TC_V)}
+ R_a={(A-1)*R*(1 + TC_R*T_Delta)}
+ R_b={R*(1 + TC_R*T_Delta)}
+ var_m={sigma_m_R^2/2 + (sigma_TC_tr_R*T_Delta)^2/2}
+ lot_1={sigma_R^2 + (sigma_TC_R*T_Delta)^2}

V1 1 0 V value={0} dc={V_DC_T} dcvar={(sigma_V*V_DC_T)^2}
R1 1 out R value={R_a} dcvar={var_m} dcvarlot={lot_1}
R2 out 0 R value={R_b} dcvar={var_m} dcvarlot={lot_1}

.end